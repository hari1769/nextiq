# RetailIQ Environment Configuration
# Google Gemini API Key (Enter your Gemini API key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Local Database & Networking
DATABASE_URL=sqlite:///./retail.db
CORS_ORIGINS=http://localhost:5173
PORT=8000
